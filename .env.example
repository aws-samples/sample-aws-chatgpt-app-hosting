# AWS Configuration
AWS_REGION=us-east-1
AWS_PAGER=

# OpenSearch Endpoint (get from CDK outputs after deployment)
# Example: https://abc123xyz.us-east-1.aoss.amazonaws.com
OPENSEARCH_ENDPOINT=

# Cognito Configuration (get from CDK outputs after deployment)
USER_POOL_ID=
CLIENT_ID=
DISCOVERY_URL=

# Test User Credentials (for creating test users)
USERNAME=testuser
PASSWORD=

# Optional: Bedrock Configuration
BEDROCK_MODEL_ID=amazon.titan-embed-text-v1
BEDROCK_REGION=us-east-1
