# AWS Configuration
AWS_REGION=us-east-1
AWS_PAGER=

# OpenSearch Endpoint (the OpenSearchEndpoint output from `agentcore deploy`)
# Example: https://abc123xyz.us-east-1.aoss.amazonaws.com
OPENSEARCH_ENDPOINT=

# Optional: override the CloudFormation stack the data/image scripts read
# outputs from. Defaults to AgentCore-CoffeeDiscovery-default (the CLI names
# stacks AgentCore-<project>-<target>).
# AGENTCORE_STACK_NAME=AgentCore-CoffeeDiscovery-default

# Optional: image generation/upload (Nova Canvas). Both are read from the
# stack outputs when unset.
# S3_BUCKET=
# CLOUDFRONT_DOMAIN=

# Optional: Bedrock Configuration
BEDROCK_MODEL_ID=amazon.titan-embed-text-v1
BEDROCK_REGION=us-east-1
