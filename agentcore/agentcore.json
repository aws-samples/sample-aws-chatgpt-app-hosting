{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CoffeeDiscovery",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CoffeeDiscovery"
  },
  "runtimes": [
    {
      "name": "coffee_mcp",
      "build": "CodeZip",
      "entrypoint": "server.py",
      "codeLocation": "./mcp_server/",
      "runtimeVersion": "PYTHON_3_11",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": false
      },
      "protocol": "MCP"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "coffee-runtime-noauth",
      "protocolType": "MCP",
      "description": "Gateway for coffee-runtime-noauth",
      "targets": [],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}